{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build NovaGems",
      "type": "shell",
      "command": "./gradlew",
      "args": ["clean", "build"],
      "windows": {
        "command": ".\\gradlew.bat",
        "args": ["clean", "build"]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gradle"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
